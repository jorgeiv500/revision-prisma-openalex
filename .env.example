# Copie este archivo como .env y complete.
# OpenAlex pide un correo para entrar al "polite pool" (más rápido y estable).
OPENALEX_EMAIL=su_correo@utadeo.edu.co
# Clave gratuita (1 USD/día de presupuesto propio): https://openalex.org/settings/api
OPENALEX_API_KEY=
# Opcional, solo si usa el cribado asistido por IA.
ANTHROPIC_API_KEY=
MODELO_IA=claude-sonnet-5-5
